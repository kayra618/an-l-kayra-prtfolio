@page "/"
@using aasdqawdawfaefgaef.Services
@inject IDataService DataService

<PageTitle>Anıl Kayra Cengiz | Portfolio</PageTitle>

<section class="hero-content">
    <div class="glow-sphere"></div>
    <div class="hero-text-block">
        <h1 class="hero-title">
            <span class="gradient-text">Anıl Kayra</span><br />
            <span class="neon-text">Cengiz</span>
        </h1>
        <p class="hero-subtitle mb-4">
            16 yaşında bir öğrenci, 11. Sınıf öğrencisi ve C# ve python ile ilgilenen bir genç yazılımcı.
        </p>
        <div class="d-flex gap-3">
            <a href="projeler" class="btn btn-purple glow-on-hover px-4 py-2 fw-bold">
                <i class="bi bi-code-slash me-2"></i>Projelerimi Gör
            </a>
            <a href="iletisim" class="btn btn-outline-light px-4 py-2 fw-bold">
                <i class="bi bi-chat-dots me-2"></i>İletişime Geç
            </a>
        </div>
    </div>

    <div class="terminal-container d-none d-lg-block">
        <div class="terminal-card">
            <div class="terminal-header">
                <div class="terminal-dot dot-red"></div>
                <div class="terminal-dot dot-yellow"></div>
                <div class="terminal-dot dot-green"></div>
                <div class="terminal-title">kayracengiz@dev: ~</div>
            </div>
            <div class="terminal-body">
                <div class="mb-2">
                    <span class="t-prompt">~ $</span> <span class="t-cmd">cat profile.json</span>
                </div>
                <div class="ms-3">
                    <span class="t-comment">// Anıl Kayra Cengiz — Junior Developer</span><br />
                    <span class="t-key">"dil"</span>: [<span class="t-val">"C#"</span>, <span class="t-val">"Python"</span>, <span class="t-val">"HTML"</span>, <span class="t-val">"CSS"</span>],<br />
                    <span class="t-key">"yaş"</span>: <span class="t-val">"16"</span>,<br />
                    <span class="t-key">"uzmanlık"</span>: [<span class="t-val">"Python"</span>],<br />
                    <span class="t-key">"db"</span>: [<span class="t-val">"MSSQL"</span>, <span class="t-val">"SQLite"</span>]
                </div>
                <div class="mt-3 mb-2">
                    <span class="t-prompt">~ $</span> <span class="t-cmd">ping kayracengizz58@gmail.com</span>
                </div>
                <div class="ms-3">
                    <span class="t-pong">PONG — 200 OK ✓</span>
                </div>
                <div class="mt-3">
                    <span class="t-prompt">~ $</span> <span class="t-cmd">git log --oneline -3</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="main-wrapper">
    <h2 class="section-title">Neler Yapıyorum?</h2>
    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="glass-card h-100">
                <i class="bi bi-code-square fs-1 neon-text"></i>
                <h3 class="mt-3">Python Geliştirme</h3>
                <p class="text-muted">Python kullanarak veri işleme, otomasyon araçları ve çeşitli mantık algoritmaları üzerinde projeler üretiyorum.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card h-100">
                <i class="bi bi-robot fs-1 neon-text"></i>
                <h3 class="mt-3">Discord Botları</h3>
                <p class="text-muted">Discord.py ve Discord.Net kütüphanelerini kullanarak gelişmiş yönetim ve etkileşim botları hazırlıyorum.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card h-100">
                <i class="bi bi-cpu fs-1 neon-text"></i>
                <h3 class="mt-3">C# ve .NET</h3>
                <p class="text-muted">Modern C# standartlarıyla kurumsal mimarilere uygun, performanslı ve sürdürülebilir uygulamalar geliştiriyorum.</p>
            </div>
        </div>
    </div>
</section>

<style>
    .btn-purple {
        background: var(--neon-purple);
        border: none;
        color: white;
    }

    .glow-sphere {
        position: absolute;
        top: 20%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 300px;
        height: 300px;
        background: var(--neon-purple);
        filter: blur(120px);
        opacity: 0.2;
        z-index: -1;
    }

    .hero-title {
        line-height: 1.1;
        font-size: 5rem;
        font-weight: 900;
        margin-bottom: 1rem;
    }

    .terminal-container {
        flex: 1;
        max-width: 550px;
        perspective: 1000px;
    }

    .terminal-card {
        background: #0d1117;
        border: 1px solid #30363d;
        border-radius: 8px;
        width: 100%;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.1);
        overflow: hidden;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9rem;
        transform: rotateY(-5deg) rotateX(2deg);
        transition: transform 0.3s ease;
    }

    .terminal-card:hover {
        transform: rotateY(0deg) rotateX(0deg);
    }

    .terminal-header {
        background: #161b22;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid #30363d;
    }

    .terminal-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .dot-red { background: #ff5f56; }
    .dot-yellow { background: #ffbd2e; }
    .dot-green { background: #27c93f; }

    .terminal-title {
        color: #8b949e;
        margin-left: auto;
        margin-right: auto;
        font-size: 0.8rem;
    }

    .terminal-body {
        padding: 20px;
        line-height: 1.5;
        text-align: left;
    }

    .t-prompt { color: #58a6ff; }
    .t-cmd { color: #f8fafc; }
    .t-comment { color: #8b949e; }
    .t-key { color: #22d3ee; }
    .t-val { color: #4ade80; }
    .t-pong { color: #4ade80; }

    @@media (max-width: 992px) {
        .hero-title {
            font-size: 3.5rem;
        }
    }
</style>
